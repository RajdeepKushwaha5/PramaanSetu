# ---- Gemini free-tier keys (rolling pool) ----
# Get free keys at https://aistudio.google.com/apikey
# List several comma-separated; the key manager rotates across them.
GEMINI_API_KEYS=key1,key2,key3

GEMINI_MODEL=gemini-2.5-flash
GEMINI_COOLDOWN_MS=60000

# Server
PORT=4000
# Comma-separated allowed origins for the frontend (defaults to allow-all in dev)
CORS_ORIGIN=http://localhost:3000

# Required to enable the privileged POST /api/issuers endpoint. If unset,
# public issuer creation is disabled and issuers come only from /api/seed.
ADMIN_API_KEY=
