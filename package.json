{
  "name": "pramaansetu",
  "version": "0.1.0",
  "private": true,
  "description": "PramaanSetu — trust layer for securities market communications (SEBI TechSprint 2026)",
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "test": "npm --prefix backend test",
    "benchmark": "npm --prefix backend run benchmark",
    "benchmark:scale": "npm --prefix backend run benchmark:scale",
    "benchmark:real": "npm --prefix backend run benchmark:real",
    "benchmark:detection": "npm --prefix backend run benchmark:detection",
    "demo:reset": "npm --prefix backend run demo:reset",
    "verify:record": "npm --prefix backend run verify:record --"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
